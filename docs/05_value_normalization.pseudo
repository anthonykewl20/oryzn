# Canonical Project field-value normalization

# Verified against GitHub's 2024-06-27 Projects V2 webhook changelog shape:
# changes.field_value = {
#   field_node_id, field_type: "single_select", field_name, project_number,
#   from: {id, name, color, description} OR null,
#   to:   {id, name, color, description} OR null
# }

TYPE NormalizationResult =
    {outcome: "supported", field_node_id: text, field_name: text,
     field_type: "single_select", values: {
         previous_value: JSON OR explicit_null,
         current_value: JSON OR explicit_null
     }}
    OR {outcome: "unsupported", reason: human-readable text}

ROUTINE normalizeFieldValue(fieldValue) -> NormalizationResult
    IF fieldValue is not an object OR fieldValue.field_type != "single_select"
        RETURN unsupported("field type " + explicit_value_or_unknown(fieldValue.field_type) +
                           " not yet supported")
    END IF

    IF fieldValue.field_node_id is not text OR fieldValue.field_name is not text
        RETURN unsupported("single_select field requires field_node_id and field_name")
    END IF

    previous_value = normalize_single_select_side(fieldValue.from, "from")
    current_value = normalize_single_select_side(fieldValue.to, "to")
    IF either side is unsupported
        RETURN that unsupported result
    END IF

    RETURN {
        outcome: "supported",
        field_node_id: fieldValue.field_node_id,
        field_name: fieldValue.field_name,
        field_type: "single_select",
        values: {
            previous_value: previous_value,
            current_value: current_value
        }
    }
END ROUTINE

ROUTINE normalize_single_select_side(raw, side_name)
    IF raw is absent OR explicit_null
        # `to = null` is a cleared value; `from = null` is a newly-set value.
        RETURN explicit_null
    END IF

    IF raw is not an object OR raw.id is not text OR raw.name is not text
        RETURN unsupported("single_select " + side_name + " value requires id and name")
    END IF

    # Copy only verified identity and label. Never invent values and never copy
    # color or description into the canonical event.
    RETURN {option_id: raw.id, label: raw.name}
END ROUTINE

ROUTINE unsupported(message) -> NormalizationResult
    # Caller retains webhook_deliveries evidence and marks it failed inline.
    RETURN {outcome: "unsupported", reason: message}
END ROUTINE

# Day 2 intentionally supports only single_select. Text, number, date, and iteration
# remain unsupported until Day 3. Identity and event metadata remain ingestion inputs.
