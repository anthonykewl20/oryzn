# PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oryzn
# Password protecting prototype administration routes.
PROTOTYPE_ADMIN_PASSWORD=replace-with-a-strong-password
# Numeric identifier for the GitHub App.
GITHUB_APP_ID=replace-with-github-app-id
# PEM-encoded private key for the GitHub App (use escaped newlines when needed).
GITHUB_PRIVATE_KEY=replace-with-github-private-key
# Shared secret used to validate GitHub webhook signatures.
GITHUB_WEBHOOK_SECRET=replace-with-github-webhook-secret
# Installation identifier for the target GitHub organization.
GITHUB_INSTALLATION_ID=replace-with-github-installation-id
# GraphQL node identifier for the tracked GitHub Project.
GITHUB_TARGET_PROJECT_NODE_ID=replace-with-project-node-id
